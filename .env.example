# ==============================================================================
# jobdec — Configuration & Credentials Template
# ==============================================================================
# Copy this file to .env (either in this directory or one directory up)
# and fill in your details. Never commit your real .env file.
# ==============================================================================

# --- AI Engine Credentials (Optional) ---
# If unset, jobdec runs completely FREE using local rule matching and local neural embeddings.
# If set, agents can use Claude (Haiku/Sonnet/Opus) for enhanced scoring and answers.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Candidate Profile Invariants ---
CANDIDATE_FIRST_NAME=Alex
CANDIDATE_LAST_NAME=Doe
CANDIDATE_PREFERRED_NAME=Alex
CANDIDATE_FULL_NAME=Alex Doe
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_PHONE=555-0199
CANDIDATE_PHONE_COUNTRY_CODE=+1
CANDIDATE_PHONE_DEVICE_TYPE=Mobile

# Location / Address
CANDIDATE_ADDRESS_LINE_1=123 Innovation Way
CANDIDATE_ADDRESS_LINE_2=
CANDIDATE_CITY=Atlanta
CANDIDATE_COUNTY=Fulton
CANDIDATE_STATE=Georgia
CANDIDATE_STATE_CODE=GA
CANDIDATE_ZIP_CODE=30303
CANDIDATE_COUNTRY=United States of America
CANDIDATE_LOCATION_TEXT=Atlanta, GA

# Social & Portfolios
CANDIDATE_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
CANDIDATE_GITHUB_URL=https://github.com/yourhandle
CANDIDATE_PORTFOLIO_URL=https://yourportfolio.com

# Education
CANDIDATE_UNIVERSITY=State University
CANDIDATE_COLLEGE=College of Computing & Business
CANDIDATE_DEGREE=Bachelor of Science
CANDIDATE_DEGREE_EXACT=Bachelor of Science in Computer Science
CANDIDATE_MAJOR=Computer Science
CANDIDATE_MAJOR_CONCENTRATION=Artificial Intelligence
CANDIDATE_CURRENT_YEAR=Junior
CANDIDATE_GPA=3.80
CANDIDATE_MAX_GPA=4.00
CANDIDATE_EXPECTED_GRAD_MONTH=May
CANDIDATE_EXPECTED_GRAD_YEAR=2027
CANDIDATE_EXPECTED_GRAD_DATE=May 2027
CANDIDATE_CURRENTLY_ENROLLED=true
CANDIDATE_RETURNING_STUDENT=true

# Work Authorization & Legal
CANDIDATE_US_CITIZEN=true
CANDIDATE_CITIZENSHIP_COUNTRY=United States of America
CANDIDATE_LEGALLY_AUTHORIZED_US=true
CANDIDATE_REQUIRES_SPONSORSHIP=false
CANDIDATE_WILL_REQUIRE_FUTURE_SPONSORSHIP=false
CANDIDATE_ITAR_STATUS=true
CANDIDATE_SECURITY_CLEARANCE=None
CANDIDATE_AGE_18_OR_OLDER=true

# Availability & Preferences
CANDIDATE_INTERNSHIP_SEASON=Summer 2027
CANDIDATE_AVAILABLE_START_DATE=06/01/2027
CANDIDATE_AVAILABLE_END_DATE=08/15/2027
CANDIDATE_WILLING_TO_RELOCATE=true
CANDIDATE_ABLE_TO_COMMUTE=true
CANDIDATE_WILLING_FLEXIBLE_SHIFTS=false
CANDIDATE_PREVIOUSLY_EMPLOYED_AT_TARGET=false
CANDIDATE_RELATIVES_AT_TARGET=false
CANDIDATE_NON_COMPETE_RESTRICTIONS=false
CANDIDATE_GOVERNMENT_OFFICIAL_TIES=false

# Voluntary Self-Identification (EEO)
CANDIDATE_GENDER=Prefer not to say
CANDIDATE_HISPANIC_LATINO=No
CANDIDATE_RACE=Decline to self-identify
CANDIDATE_VETERAN_STATUS=I am not a protected veteran
CANDIDATE_DISABILITY_STATUS=I do not have a disability
CANDIDATE_PRONOUNS=They/Them
CANDIDATE_REFERRAL_SOURCE=LinkedIn

# Behavioral & Open-Ended Templates
CANDIDATE_ELEVATOR_PITCH=I specialize in software engineering, automation workflows, and agentic AI systems. I build reliable end-to-end applications and data pipelines that eliminate repetitive friction and improve operational efficiency.
CANDIDATE_PROUDEST_ACHIEVEMENT=Designed and deployed automated operational pipelines handling enterprise data and process workflows, cutting manual coordination overhead significantly while maintaining zero data loss.
CANDIDATE_TOP_SKILLS=Python, SQL, Playwright, Machine Learning, TypeScript, React, Docker, Git

# --- ATS Portal & Authentication ---
# Default password used when auto-registering candidate accounts on Workday / Taleo / iCIMS
PORTAL_PASSWORD=YourSecurePortalPassword123!
AUTO_CREATE_ACCOUNTS=true

# --- Email Automation (Optional for OTP & Activation Links) ---
# If provided, jobdec automatically checks your inbox for Workday account activation emails
# and one-time verification security codes (OTP) during application submission.
GMAIL_EMAIL=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# --- Runtime Flags ---
HEADLESS=true
RESUME_FILENAME=Candidate_Resume.pdf
